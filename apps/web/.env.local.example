# ----------------------------------------------------------------------------
# Knowledge Map AI — local environment example
# ----------------------------------------------------------------------------
#
# Copy this file to `.env.local` (gitignored) only if you are running Knowledge
# Map AI in LOCAL PRIVATE MODE on your own machine, and you have a populated
# C:\Drive-semantic\context-packs\ folder behind the
# apps/web/public/context-packs junction.
#
# DO NOT commit a real .env.local.
# DO NOT set this flag in any public deployment (e.g. map.clawshow.ai) unless
# the served Context Packs are sanitized demo packs.
#
# See: docs/setup/2026-05-30-context-pack-exchange-setup.md
# ----------------------------------------------------------------------------

# When set to "true", the left sidebar fetches /context-packs/index.json and
# lists Local Context Packs alongside the built-in Accounting / Exhibition demos.
# When unset, missing, or set to any other value, the app runs in Public Demo
# Mode and shows only the built-in demos.
NEXT_PUBLIC_ENABLE_CONTEXT_PACKS=true
